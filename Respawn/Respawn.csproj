<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Respawn</RootNamespace>
    <AssemblyName>Respawn</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
     <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Interop.IWshRuntimeLibrary" Version="1.0.1">
    <NoWarn>NU1701</NoWarn>
  </PackageReference>
  <PackageReference Include="System.Management" Version="10.0.4" />
  <PackageReference Include="TaskScheduler" Version="2.12.2">
    <NoWarn>NU1603</NoWarn>
  </PackageReference>
  </ItemGroup>

</Project>